{
  "name": "deep-space-derby",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,display,ctrl -c blue,green,yellow \"bun --hot src/server/index.ts\" \"vite --config src/display/vite.config.ts\" \"vite --config src/controller/vite.config.ts --port 5174\"",
    "build": "bun run build:display && bun run build:controller",
    "build:display": "vite build --config src/display/vite.config.ts",
    "build:controller": "vite build --config src/controller/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.3.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-router": "^1.79.0",
    "hono": "^4.6.0",
    "pixi.js": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
